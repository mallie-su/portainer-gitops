{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":automergeDigest",
        ":automergeMinor"
    ],
    "branchNameStrict": true,
    "pinDigests": true,
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch"],
            "matchCurrentVersion": "!/^0/",
            "automerge": true
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^values.yaml$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s*depName=(?<depName>.*?)\\s*(versioning=(?<versioning>.*?))?\\n\\s*tag=\"?(?<currentValue>.*)\"?"
            ],
            "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
        }
    ],
    "docker-compose": {
        "managerFilePatterns": [
            "/(^|/)(?:[a-zA-Z]+-)?compose[^/]*\\.ya?ml$/"
        ]
    }
}
